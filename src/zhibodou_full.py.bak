scrcpy_process = None
scrcpy_hwnd = 0
system_power = False
live_running = False
screenshot_working = False
locker = threading.Lock()
can_next_speak = True
count_down_sec = 0
seq_index = 0   #直播顺序循环 0区间1，1区间2，2区间3

DEFAULT_CFG = {
    "product_name": "日用百货",
    "product_desc": "你就是今天的主播 用中国话直接说话术 不要讲解 日用百货 品类多一一展示 下方小黄车直接拍",
    "pre_meet_text": "你就是今天的主播 用中国话直接说话术 不要讲解 日用百货 品类多一一展示 下方小黄车随便拍",
    "r1_min": "0", "r1_max": "30", "cmd1": "留人话术内容填这里",
    "r2_min": "30", "r2_max": "100", "cmd2": "产品讲解话术内容填这里",
    "r3_min": "100", "r3_max": "9999", "cmd3": "逼单促单话术内容填这里",
    "script_interval": 25
}

online_num = 0
like_cnt = 0
gift_cnt = 0
comment_cnt = 0
inner_audio_mode = False
msg_queue = queue.Queue(maxsize=100)

# ====================== scrcpy自动启动嵌入+强锁死窗口 ======================
def start_scrcpy_embed():
    global scrcpy_process, scrcpy_hwnd
    if scrcpy_process is not None:
        return
    if not os.path.exists(SCRCPY_EXE):
        messagebox.showerror("文件缺失", f"找不到scrcpy.exe\n{SCRCPY_EXE}")
        return

    scrcpy_process = subprocess.Popen([
        SCRCPY_EXE,
        "--window-title", "scrcpy",
        "--max-size", "620"
    ], cwd=SCRCPY_DIR)

    def embed_work():
        global scrcpy_hwnd
        parent_hwnd = get_tk_widget_hwnd(embed_container)
        max_wait_sec = 8
        spent = 0
        scrcpy_hwnd = 0
        while spent < max_wait_sec:
            scrcpy_hwnd = find_scrcpy_main_hwnd()
            if scrcpy_hwnd != 0:
                break
            time.sleep(0.35)
            spent += 0.35
        if scrcpy_hwnd and parent_hwnd:
            real_embed_window(scrcpy_hwnd, parent_hwnd, 0, 0, 290, 530)

    threading.Thread(target=embed_work, daemon=True).start()

def lock_scrcpy_loop():
    global scrcpy_hwnd
    parent_hwnd = get_tk_widget_hwnd(embed_container)
    while system_power and scrcpy_hwnd != 0:
        try:
            style = user32.GetWindowLongW(scrcpy_hwnd, GWL_STYLE)
            style = style & (~WS_CAPTION) & (~WS_THICKFRAME) & (~WS_SYSMENU)
            user32.SetWindowLongW(scrcpy_hwnd, GWL_STYLE, style)
            ex_style = user32.GetWindowLongW(scrcpy_hwnd, GWL_EXSTYLE)
            ex_style = ex_style | WS_EX_TRANSPARENT
            user32.SetWindowLongW(scrcpy_hwnd, GWL_EXSTYLE, ex_style)
            user32.MoveWindow(scrcpy_hwnd, 0, 0, 290, 530, True)
        except Exception:
            pass
        time.sleep(0.15)

def stop_scrcpy_embed():
    global scrcpy_process, scrcpy_hwnd
    if scrcpy_process:
        try:
            scrcpy_process.terminate()
        except Exception:
            pass
        scrcpy_process = None
    scrcpy_hwnd = 0

# ====================== 弹幕解析 ======================
def parse_danmu(msg):
    global online_num, like_cnt, gift_cnt, comment_cnt
    try:
        m_online = re.search(r"直播间人数[:：]\s*(\d+)", msg)
        if m_online:
            online_num = int(m_online.group(1))
            root.after(0, lambda: lab_online.config(text=f"📶 在线：{online_num} 人"))

        m_like = re.search(r"总点赞(\d+)", msg)
        if m_like:
            like_cnt = int(m_like.group(1))
            root.after(0, lambda: lab_like.config(text=f"👍 点赞：{like_cnt}"))

        if "$来了" in msg:
            gift_cnt += 1
            root.after(0, lambda: lab_gift.config(text=f"🎁礼物：{gift_cnt}"))

        m_comment = re.search(r"\[弹幕消息\]\s*\[(.*?)\]\s*(.+?)[:：](.+)", msg)
        if m_comment:
            uname = m_comment.group(2).strip()
            cnt = m_comment.group(3).strip()
            comment_cnt += 1
            tim = time.strftime("%H:%M:%S")
            root.after(0, lambda t=tim, u=uname, c=cnt: txt_danmu.insert(tk.END, f"[{t}] {u}：{c}\n") or txt_danmu.see(tk.END))
    except Exception:
        pass

def ws_danmu_loop():
    while live_running and system_power:
        try:
            ws = websocket.WebSocketApp(WS_SERVER_URL, on_message=lambda w,m: parse_danmu(m))
            ws.run_forever()
        except Exception:
            time.sleep(2)

# ====================== 截图抓屏模块 ======================
def screen_capture_loop():
    global screenshot_working
    while screenshot_working and system_power:
        try:
            img = pyautogui.screenshot()
            t = time.strftime("%H:%M:%S")
            msg_queue.put(f"[{t}] 抓取画面完成\n")
            time.sleep(1.0)
        except Exception:
            time.sleep(1)

def ui_refresh_msg():
    while not msg_queue.empty():
        s = msg_queue.get()
        txt_screen_log.insert(tk.END, s)
        txt_screen_log.see(tk.END)
    if screenshot_working:
        root.after(200, ui_refresh_msg)

def start_capture():
    global screenshot_working
    if not system_power:
        messagebox.showwarning("提示", "请先打开总电源！")
        return
    if screenshot_working:
        return
    screenshot_working = True
    threading.Thread(target=screen_capture_loop, daemon=True).start()
    root.after(100, ui_refresh_msg)
    lab_cap_status.config(text="抓屏：运行中 🟢", fg="#34d399")

def stop_capture():
    global screenshot_working
    screenshot_working = False
    lab_cap_status.config(text="抓屏：已停止 ⏸️", fg="#fbbf24")
    txt_screen_log.delete(1.0, tk.END)

# ====================== 总电源开关 ======================
def power_on_self_check():
    """开机自检：adb设备 / 豆包前台 / clipper安装。返回问题列表（空=全部通过）"""
    problems = []
    # 1. adb 设备在线
    try:
        r = subprocess.run([ADB_EXE,"devices"], capture_output=True, timeout=5)
        out = r.stdout.decode("utf-8", errors="ignore")
        online = [l for l in out.splitlines() if l.endswith("\tdevice")]
        if not online:
            problems.append("❌ 没有检测到 adb 设备，请用USB连接手机并授权调试")
    except Exception:
        problems.append("❌ adb 命令执行失败，请确认 adb 已加入 PATH")
    # 2. 豆包在前台
    try:
        r = subprocess.run([ADB_EXE,"shell", "dumpsys", "window"], capture_output=True, timeout=5)
        if DOUBAO_PKG not in r.stdout.decode("utf-8", errors="ignore"):
            problems.append("⚠️ 豆包 APP 不在前台，请打开豆包进入对话页")
    except Exception:
        pass
    # 3. ADBKeyboard 已安装（文字直输主通道；Android 10+ 剪贴板方案已不可用）
    if not check_adbkeyboard_installed():
        problems.append("⚠️ 手机未安装 ADBKeyboard：话术将无法输入豆包！\n"
                        "   （Android 10+ 禁止后台写剪贴板，clipper 方案已失效。\n"
                        f"    请用 adb install {ADBKEYBOARD_APK} 安装，程序目录已附带）")
    elif ADB_IME_ID not in _ime_current():
        problems.append("ℹ️ ADBKeyboard 已安装但不是当前输入法（程序会在发送时自动临时切换）")
    return problems

def toggle_power():
    global system_power, live_running, screenshot_working
    if check_cannot_power_on():
        messagebox.showerror("禁止开机", "授权异常，无法启动系统")
        return
    if not system_power:
        system_power = True
        # 开机自检：设备/豆包前台/clipper，问题当场暴露
        problems = power_on_self_check()
        if problems:
            messagebox.showwarning("开机自检发现问题", "\n\n".join(problems))
        btn_power.config(bg="#00aa44")
        winsound.Beep(1000, 120)
        lab_sys_status.config(text="状态：待机【测试】✅", fg="#34d399")
        btn_meet.config(state=tk.NORMAL)
        btn_live_start.config(state=tk.NORMAL)
        btn_audio_mode.config(state=tk.NORMAL)
        btn_cap.config(state=tk.NORMAL)
        start_scrcpy_embed()
        threading.Thread(target=lock_scrcpy_loop, daemon=True).start()
    else:
        system_power = False
        live_running = False
        screenshot_working = False
        stop_scrcpy_embed()
        stop_capture()
        btn_power.config(bg="#bb2222")
        winsound.Beep(600,120)
        lab_sys_status.config(text="状态：已关机 ❌", fg="#ef4444")
        btn_meet.config(state=tk.DISABLED)
        btn_live_start.config(state=tk.DISABLED)
        btn_live_stop.config(state=tk.DISABLED)
        btn_audio_mode.config(state=tk.DISABLED)
        btn_cap.config(state=tk.DISABLED)
        txt_danmu.delete(1.0, tk.END)
        txt_screen_log.delete(1.0, tk.END)

# ====================== TTS语音播报 ======================
def speak_text(text):
    if inner_audio_mode:
        return
    try:
        eng = pyttsx3.init()
        eng.setProperty("rate", 138)
        eng.setProperty("volume", 0.95)
        eng.say(text)
        eng.runAndWait()
        eng.stop()
    except Exception:
        pass

# ====================== 开播预演【读取界面文本框，写入手机剪贴板，隔离电脑剪贴板】 ======================
def run_pre_meet():
    """执行开播预演：内容完全取自界面开播预演文本框，不会发送电脑复制的代码"""
    if not system_power:
        messagebox.showwarning("提示", "请先打开总电源！")
        return
    content = txt_pre_meet.get(1.0, tk.END).strip()
    if not content:
        messagebox.showwarning("提示", "开播预演文本框不能为空！")
        return
    if scrcpy_hwnd == 0:
        messagebox.showerror("错误", "scrcpy投屏窗口句柄无效，请确认投屏已经嵌入成功！")
        return

    ok, err = send_text_to_doubao(content)
    if not ok:
        lab_sys_status.config(text="状态：❌预演下发失败", fg="#ff6b6b")
        messagebox.showerror("下发失败",
                             f"话术未能发送到豆包对话：\n\n{err}\n\n"
                             f"提示：手机需安装 {ADBKEYBOARD_APK}（已在程序目录），\n"
                             "且豆包需停留在前台对话页。")
        return

    lab_sys_status.config(text="状态：✅预演话术已发送（经发送验证）", fg="#34d399")
    messagebox.showinfo("完成", "✅预演完成：话术已确认发送到豆包对话界面！")

# ====================== 直播发送话术，读取区间1/2/3的内容，写入手机剪贴板 ======================
def send_script_content(text):
    global can_next_speak
    with locker:
        if not can_next_speak:
            return
        can_next_speak = False
        if scrcpy_hwnd == 0:
            return

        ok, err = send_text_to_doubao(text)
        if not ok:
            _ui_status("❌话术发送失败: " + err[:36], "#ff6b6b")
            can_next_speak = True
            return

        threading.Thread(target=count_down_work, daemon=True).start()

def toggle_audio_mode():
    global inner_audio_mode
    inner_audio_mode = not inner_audio_mode
    if inner_audio_mode:
        btn_audio_mode.config(text="🔇内录模式(剪贴板)", bg="#333333", fg="white")
    else:
        btn_audio_mode.config(text="🔊外音模式(TTS语音)", bg="#06d6a0", fg="black")

def count_down_work():
    global can_next_speak, count_down_sec
    cfg = load_config()
    count_down_sec = int(cfg["script_interval"])
    while count_down_sec > 0 and live_running and system_power:
        root.after(0, lambda t=count_down_sec: lab_count.config(text=f"⏱间隔：{t} 秒"))
        time.sleep(1)
        count_down_sec -= 1
    can_next_speak = True
    root.after(0, lambda: lab_count.config(text="✅可以执行下一轮"))

# ====================== 自动直播循环：读取界面区间1→2→3顺序循环 ======================
def auto_live_loop():
    global live_running, seq_index, can_next_speak
    seq_index = 0
    while live_running and system_power:
        try:
            if can_next_speak:
                cfg = load_config()
                if seq_index == 0:
                    text = cfg["cmd1"]
                elif seq_index == 1:
                    text = cfg["cmd2"]
                else:
                    text = cfg["cmd3"]

                if text.strip():
                    send_script_content(text)

                seq_index = (seq_index + 1) % 3
            time.sleep(0.5)
        except Exception:
            pass

def start_live():
    global live_running, seq_index
    if not system_power:
        messagebox.showwarning("提示", "请先打开总电源")
        return
    live_running = True
    seq_index = 0
    btn_live_start.config(state=tk.DISABLED)
    btn_live_stop.config(state=tk.NORMAL)
    lab_sys_status.config(text="状态：直播运行｜顺序循环区间1‑2‑3", fg="#34d399")
    threading.Thread(target=ws_danmu_loop, daemon=True).start()
    threading.Thread(target=auto_live_loop, daemon=True).start()
    start_capture()

def stop_live():
    global live_running
    live_running = False
    stop_capture()
    btn_live_start.config(state=tk.NORMAL)
    btn_live_stop.config(state=tk.DISABLED)
    lab_sys_status.config(text="状态：待机【测试】✅", fg="#34d399")
    lab_count.config(text="✅可以执行下一轮")

# ====================== 配置读写 ======================
def load_config():
    if os.path.exists(CONFIG_JSON):
        try:
            with open(CONFIG_JSON, "r", encoding="utf-8") as f:
                d = json.load(f)
            return {**DEFAULT_CFG, **d}
        except Exception:
            pass
    return DEFAULT_CFG.copy()

def save_config():
    try:
        d = {
            "product_name": ent_prod_name.get().strip(),
            "product_desc": ent_prod_desc.get().strip(),
            "pre_meet_text": txt_pre_meet.get(1.0, tk.END).strip(),
            "r1_min": ent_r1min.get(), "r1_max": ent_r1max.get(), "cmd1": ent_cmd1.get(),
            "r2_min": ent_r2min.get(), "r2_max": ent_r2max.get(), "cmd2": ent_cmd2.get(),
            "r3_min": ent_r3min.get(), "r3_max": ent_r3max.get(), "cmd3": ent_cmd3.get(),
            "script_interval": ent_interval.get()
        }
        with open(CONFIG_JSON, "w", encoding="utf-8") as f:
            json.dump(d, f, ensure_ascii=False, indent=2)
        messagebox.showinfo("成功", "✅配置保存完成")
    except Exception as e:
        messagebox.showerror("错误", f"保存失败：{e}")

# ====================== 密码弹窗 ======================
def dialog_modify_pwd():
    old = simpledialog.askstring("验证旧密码", "请输入管理员旧密码", show="*")
    if old is None:
        return
    if not verify_admin_pwd(old):
        messagebox.showerror("错误", "旧密码不正确")
        return
    new1 = simpledialog.askstring("设置新密码", "请输入新密码", show="*")
    if new1 is None:
        return
    new2 = simpledialog.askstring("确认新密码", "再次输入新密码", show="*")
    if new1 != new2:
        messagebox.showerror("错误", "两次密码不一致")
        return
    if change_admin_password(old, new1):
        messagebox.showinfo("成功", "密码修改成功")
    else:
        messagebox.showerror("错误", "修改失败")

